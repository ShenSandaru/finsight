# Database Configuration
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=finsight_secret_123
POSTGRES_DB=finsight_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Gemini Embedding Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Security & CORS Configuration (Comma-separated origins, no wildcards by default)
CORS_ORIGINS=http://localhost:3000

# Backend Concurrency (Uvicorn workers per container, defaults to 1 for in-process pool safety)
WEB_CONCURRENCY=1

# Container Port Bindings (Host ports)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Client-side API URL (Embedded at build time into frontend assets)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication & Google OAuth 2.0 / OIDC Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8888/api/v1/auth/google/callback
SESSION_SECRET_KEY=dev-session-secret-key-change-in-production
SESSION_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Rate Limiting & Abuse Protection (Phase 12.3)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_RAG=20/60
RATE_LIMIT_SEARCH=30/60
RATE_LIMIT_REPORTS=5/60
RATE_LIMIT_DOCUMENT_UPLOAD=10/60
RATE_LIMIT_CONVERSATION_QUERY=20/60
RATE_LIMIT_GENERAL=100/60

# File Storage Configuration (Phase 12.4)
# Currently supported: 'local' (uses Docker named volume 'finsight_storage' mounted at /app/storage)
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage

# Observability & Structured Logging (Phase 12.5)
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: json (production machine-readable) | text (development human-readable)
LOG_LEVEL=INFO
LOG_FORMAT=json
